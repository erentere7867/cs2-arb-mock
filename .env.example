# Optional CSFloat API key; if blank, CSFloat requests are unauthenticated.
CSFLOAT_API_KEY=

# DMarket public key (hex); DMarket requires both keys and has no public fallback.
DMARKET_PUBLIC_KEY=

# DMarket secret key (hex); service jobs select DMarket via the config's markets list.
DMARKET_SECRET_KEY=

# Skinport client ID; not used by the public market reads.
SKINPORT_CLIENT_ID=

# Skinport client secret; not used by the public market reads.
SKINPORT_CLIENT_SECRET=

# Waxpeer reads are public and need no API key.
