# Optional CSFloat API key; if blank, CSFloat requests are unauthenticated.
CSFLOAT_API_KEY=

# DMarket public key (hex); DMarket has no public fallback and stays off until both keys are set.
DMARKET_PUBLIC_KEY=

# DMarket secret key (hex); after setting both keys, restart the jobs to enable DMarket:
# sudo systemctl restart cs2-arb-mock@cs2 cs2-arb-mock@rust
DMARKET_SECRET_KEY=

# Skinport client ID; not used by the public market reads.
SKINPORT_CLIENT_ID=

# Skinport client secret; not used by the public market reads.
SKINPORT_CLIENT_SECRET=

# Waxpeer reads are public and need no API key.
