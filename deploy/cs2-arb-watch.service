[Unit]
Description=CS2 public update watcher
Wants=network-online.target
After=network-online.target

[Service]
User=ubuntu
Environment=RUST_LOG=info
WorkingDirectory=/home/ubuntu/cs2-arb-mock-data
ExecStart=/usr/local/bin/cs2-arb-run watch
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/cs2-arb-mock-data

[Install]
WantedBy=multi-user.target
