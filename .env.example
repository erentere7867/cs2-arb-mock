# Optional CSFloat API key for authenticated, read-only market requests.
CSFLOAT_API_KEY=

# Hex-encoded DMarket public key for signed reads when DMarket is enabled.
DMARKET_PUBLIC_KEY=

# Hex-encoded DMarket secret key for signing those read requests.
DMARKET_SECRET_KEY=

# Skinport client ID; not used by the public market reads.
SKINPORT_CLIENT_ID=

# Skinport client secret; not used by the public market reads.
SKINPORT_CLIENT_SECRET=
